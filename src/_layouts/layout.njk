<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "My Personal Blog" }}</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  <header class="site-header">
    <div class="site-title">
      <a href="{{ '/' | url }}">My Personal Blog</a>
    </div>

    <button class="menu-button" type="button" aria-label="メニューを開く">
      ≡
    </button>

    <nav class="site-nav">
      <a href="{{ '/' | url }}">Home</a>
      <a href="{{ '/about/' | url }}">About</a>
      <a href="{{ '/categories/' | url }}">Categories</a>
      <a href="{{ '/search/' | url }}">Search</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>

  <script>
    const menuButton = document.querySelector(".menu-button");
    const siteNav = document.querySelector(".site-nav");

    menuButton.addEventListener("click", () => {
      siteNav.classList.toggle("is-open");
    });
  </script>  
</body>
</html>